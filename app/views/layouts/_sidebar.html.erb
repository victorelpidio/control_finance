<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px; min-height: 100vh;">
  <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
    <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"></use></svg>
    <span class="fs-4">Control Finance</span>
  </a>
  <hr>
  <ul class="nav nav-pills flex-column mb-auto">
    <li>
      <%= link_to panels_path, class: 'nav-link text-white' do %>
        <svg class="bi me-2" width="16" height="16"><use xlink:href="#calendar"></use></svg>
        Controle dos meses
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to banks_path, class: 'nav-link text-white' do %>
        <svg class="bi me-2" width="16" height="16"><use xlink:href="#list"></use></svg>
        Lista de Bancos
      <% end %>
    </li>
  </ul>
  <hr>
</div>