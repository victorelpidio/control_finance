<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table">
      <tr>
        <th scope="col">Nome</th>
        <th scope="col">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @banks.each do |bank| %>
        <tr>
          <td><%= bank.name %></td>
          <td>
            <div style="display: flex; gap: 8px;">
              <%= link_to 'Editar', edit_bank_path(bank), class: 'btn btn-sm btn-warning' %>
              <%= button_to "Deletar", bank_path(bank), method: :delete, data: { confirm: 'Tem certeza que deseja excluir?' }, class: 'btn btn-sm btn-danger' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>