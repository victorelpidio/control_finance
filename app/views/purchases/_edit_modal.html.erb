<div class="modal fade"
     id="purchaseEditModal-<%= purchase.id %>"
     tabindex="-1"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header bg-primary text-white rounded-top-4">
        <div>
          <h5 class="modal-title fw-bold mb-0">
            Editar Compra
          </h5>
        </div>
        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal">
        </button>
      </div>
      <div class="modal-body p-4">
        <%= simple_form_for [panel, purchase] do |f| %>
          <div class="row">
            <div class="col-12 mb-3">
              <%= f.input :description,
                  label: 'Descrição',
                  placeholder: 'Ex: Mercado, Internet, Energia...',
                  input_html: { class: 'form-control rounded-3' },
                  label_html: { class: 'fw-semibold' } %>
            </div>

            <div class="col-md-6 mb-3">
              <%= f.input :value,
                  label: 'Valor',
                  placeholder: 'R$ 0,00',
                  input_html: { class: 'form-control rounded-3' },
                  label_html: { class: 'fw-semibold' } %>
            </div>

            <div class="col-md-6 mb-3">
              <%= f.input :date,
                as: :string,
                label: 'Data',
                input_html: {
                  type: 'date',
                  class: 'form-control rounded-3'
                },
                label_html: { class: 'fw-semibold' } %>
            </div>

            <div class="col-6 mb-4">
              <%= f.association :bank,
                  label: 'Banco',
                  prompt: 'Selecione um banco',
                  input_html: { class: 'form-select rounded-3' },
                  label_html: { class: 'fw-semibold' } %>
            </div>
            <div class="col-6 mb-4 d-flex align-items-end">
              <%= f.input :fixed,
                as: :boolean,
                wrapper_html: { class: 'form-check form-switch mb-0' },
                input_html: { class: 'form-check-input' },
                label_html: { class: 'form-check-label fw-semibold' },
                label: 'Compra fixa?'
              %>
            </div>
          </div>
          <div class="d-flex justify-content-end gap-2">
            <button type="button"
                    class="btn btn-light border"
                    data-bs-dismiss="modal">
              Cancelar
            </button>
            <%= f.button :submit,
                'Salvar Alterações',
                class: 'btn btn-primary px-4' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

